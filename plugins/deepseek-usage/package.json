{
  "name": "@local/dsh-plugin-deepseek-usage",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "DeepSeek 余额/Token 用量面板：左下角侧栏入口 + 会话区完整历史用量（按日期、API Key、模型筛选）。",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  }
}
